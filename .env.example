# ============================================================================
# SmartB100 — Configuration File
# ============================================================================
# Copy this file to .env and adjust the values for your environment.
# See SETUP.md for detailed configuration instructions.
# ============================================================================

# ============================================================================
# LOCAL MODE (Qdrant via Docker)
# ============================================================================
# Use these settings to run with a local Qdrant via Docker Compose.
# Command: docker compose --profile infra up -d

QDRANT_URL=http://localhost:6333
# Qdrant collection name (must match the one used at indexing time)
COLLECTION_NAME=archives_v2

# ============================================================================
# REMOTE MODE (Qdrant via ZeroTier) — COMMENTED OUT BY DEFAULT
# ============================================================================
# To use the shared remote Qdrant server:
# 1. Install and configure ZeroTier (zerotier-cli join <NETWORK_ID>)
# 2. Request the credentials from the Tech Lead
# 3. Uncomment and configure the lines below

# QDRANT_URL=http://<REMOTE_HOST_ZEROTIER>:6333
# QDRANT_API_KEY=<REQUEST_FROM_TECH_LEAD>

# ============================================================================
# OLLAMA MODELS
# ============================================================================
# Chat model (RAG answer generation).
# Options: llama3.2:3b (default, light), llama3.1:8b (more resources/quality)
CHAT_MODEL=llama3.2:3b

# Embedding model for vectorization and semantic search.
# Dimension: 768 vectors
EMBED_MODEL=nomic-embed-text

# ============================================================================
# OLLAMA HOST
# ============================================================================
# Ollama server URL, for the containerized API. The `ollama` Python library reads
# it from the process environment, which docker-compose fills from this file; it
# is NOT a Settings field, so a native `uvicorn` run does not pick it up from
# .env and always uses the library default, http://127.0.0.1:11434. Export the
# variable in the shell if a native run must reach a different host.
# - Windows/Mac (Docker Desktop): http://host.docker.internal:11434 (default).
# - Native Linux (containers): use the docker0 gateway (e.g. http://172.17.0.1:11434)
#   or add `extra_hosts: host.docker.internal:host-gateway` in compose.
OLLAMA_HOST=http://host.docker.internal:11434

# ============================================================================
# RAG SEARCH SETTINGS
# ============================================================================
# Number of most-similar chunks to retrieve in the search (top-k).
TOP_K=3

# Maximum tokens per LLM answer.
LLM_MAX_TOKENS=256

# Semantic-entropy threshold for hallucination detection (0.0-1.0).
# Lower values = stricter
HALLUCINATION_THRESHOLD=0.5

# Enables (true) or disables (false) the hallucination verification flow.
VERIFICATION_ENABLED=true

# Timeout (seconds) for the Gradio UI's POST /chat requests to the API.
# CPU-only Ollama: ~160-200s per answer; GPU: ~10-30s. Bounds: 1-3600.
CHAT_TIMEOUT=600

# Timeout (seconds) for each Ollama chat call. The Settings default is 240,
# which covers a warm CPU-only generation (~140-200s) but not the first call
# after startup: Ollama loads the model before generating, and a measured cold
# call exceeded 240s and surfaced as a 503. The value shipped here therefore
# clears the cold start; lower it on GPU. Bounds: 1-600 (under CHAT_TIMEOUT).
OLLAMA_TIMEOUT=540

# Per-user rate limit for POST /chat (slowapi format "<count>/<interval>").
# Keyed by the JWT subject, not the IP: caps how often one authenticated user
# can trigger the costly RAG + paid-verification pipeline. Exceeding it -> 429.
CHAT_RATE_LIMIT=30/minute

# LLM provider for sample generation in hallucination verification.
# Options: groq (default, fast), ollama (local), openrouter
VERIFICATION_PROVIDER=groq

# Specific model for verification. Empty = use the provider default:
#   groq: llama-3.1-8b-instant | ollama: llama3.2:3b | openrouter: google/gemma-4-31b-it
VERIFICATION_CHAT_MODEL=

# Number of samples for the semantic-entropy computation (default: 2).
ENTROPY_NUM_SAMPLES=2

# ============================================================================
# AGENT PATH (deepagents, off by default)
# ============================================================================
# The agent path routes POST /chat through a bounded deepagents loop that calls
# retrieval as a tool, instead of calling it directly. It is complete and tested
# (ADR-0008, ADR-0010, ADR-0012) and ships off: turning it on is a separate
# decision (ADR-0015). Uncomment to enable.
# AGENT_ENABLED=false

# Provider for the agent's reasoning model. ADR-0013 moved the default to local
# ollama, because a single deep-agent call is ~9.8k tokens and does not fit the
# free-tier Groq TPM cap. Options: ollama (default), groq.
# AGENT_PROVIDER=ollama

# Empty = the provider default: ollama qwen2.5:7b | groq openai/gpt-oss-20b.
# The local model must be pulled first: ollama pull qwen2.5:7b
# AGENT_MODEL=

# Run bounds, calibrated on qwen2.5:7b (ADR-0015): the observed maximum was 9
# super-steps and 19.7k tokens, and the defaults are ~1.5x that as a runaway
# backstop. Either bound ends the run with a graceful fallback, not a 503.
# AGENT_RECURSION_LIMIT=15
# AGENT_TOKEN_BUDGET=30000

# Local context window for the agent. Must exceed the ~9.8k-token deepagents
# scaffolding prompt or Ollama truncates the system prompt. Only used when
# AGENT_PROVIDER=ollama.
# AGENT_NUM_CTX=16384

# Agricultural domain gate (ADR-0010): embeds the question and compares the top
# corpus similarity against the threshold, deflecting off-domain questions before
# the agent loop. Calibrated at 0.80 (ADR-0015): admits 96.7% of in-domain
# questions while leaking 3.3% of out-of-domain ones. Fails open.
# INTENT_FILTER_ENABLED=true
# INTENT_THRESHOLD=0.80

# ============================================================================
# EXTERNAL APIS (Evaluation and Verification Pipeline)
# ============================================================================
# API keys used by the evaluation pipeline in eval/ and by hallucination verification.
# Leave empty if you will not use the evaluation pipeline.

# Groq API key (hallucination verification + eval pipeline)
GROQ_API_KEY=

# OpenRouter API key (hallucination verification + eval pipeline)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens. REQUIRED — the app will not start until set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ============================================================================
# EVALUATION PIPELINE (eval/run_evaluation.py)
# ============================================================================
# run_evaluation.py calls the authenticated POST /chat, so it needs a token.
# Either set EVAL_API_TOKEN directly, or set EVAL_USERNAME + EVAL_PASSWORD for a
# user registered via POST /auth/register (exchanged for a token at startup).
# Without credentials the run aborts immediately instead of collecting 401s.
EVAL_API_TOKEN=
EVAL_USERNAME=
EVAL_PASSWORD=
