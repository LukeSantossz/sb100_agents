# syntax=docker/dockerfile:1.7
# ============================================================================
# Stage 1: Builder — installs build-essential + pip install into an isolated venv.
# Only the resulting venv is copied to the runtime stage; the compilation
# toolchain does not ship in the final image.
# ============================================================================
FROM python:3.12.3-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Build deps (needed for wheels with C extensions, e.g. pydantic/uvicorn)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create the virtualenv that will be copied intact to the runtime stage
ENV VIRTUAL_ENV=/opt/venv
RUN python -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Leverage layer caching: the dependency description before the code.
#
# requirements.txt is generated here rather than committed. It is derived from
# uv.lock, and a derived file in git is a file that falls out of step with what
# it is derived from — which it did on every Dependabot pull request, since a
# bot can update the lockfile and cannot run uv export.
#
# --locked is what makes this safe: uv refuses to resolve anything and also
# refuses a lockfile that no longer matches pyproject.toml, so the image is
# built from the locked versions or the build fails. That is the check the
# deleted CI job was reaching for, applied to the thing that ships.
#
# uv goes into the system interpreter, not into $VIRTUAL_ENV: only the venv is
# copied to the runtime stage, and a build tool has no business shipping in it.
# It is pinned for the same reason every other tool here is.
COPY pyproject.toml uv.lock ./
RUN /usr/local/bin/python -m pip install --no-cache-dir uv==0.12.6 && \
    /usr/local/bin/uv export --locked --no-dev -o requirements.txt && \
    pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================================================
# Stage 2: Runtime — slim without build-essential. Only curl for the healthcheck.
# ============================================================================
FROM python:3.12.3-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# curl: required by the healthchecks in docker-compose.yml
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# WORKDIR /app aligns with the docker-compose bind mount
# `./smartb100_v2.db:/app/smartb100_v2.db`: `database/db.py` resolves the path via
# `Path(__file__).resolve().parents[1]`, so with the code in /app/database/ the DB
# lands at /app/smartb100_v2.db, exactly where the bind mounts it.
WORKDIR /app

# Copy the venv from the builder; activate via PATH (uvicorn comes from the venv)
ENV VIRTUAL_ENV=/opt/venv
COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy the code (filtered by .dockerignore — no tests/, eval/, .git, etc.)
COPY . .

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
