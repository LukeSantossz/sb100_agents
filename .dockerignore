# ============================================================================
# .dockerignore - Shrinks the Docker build context.
# Keeps scripts/ and archives/ available for ad-hoc indexing inside the container.
# ============================================================================

# Git
.git/
.gitignore
.gitattributes

# Python virtual environments
.venv/
venv/
ENV/
env/
Lib/
Include/
pyvenv.cfg
.python-version

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Tests and coverage
tests/
.pytest_cache/
.coverage
coverage.xml

# Eval pipeline (not used at container runtime)
eval/

# Project meta (not needed at runtime)
.claude/

# Documentation (not needed at runtime)
*.md
docs/

# CI/CD
.github/

# Environment files (passed via -e or env_file in compose)
.env
.env.local

# Local databases (mounted via volume)
smartb100_v2.db
smartb100.db

# Qdrant local storage (mounted via volume)
qdrant_storage/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.temp
*.log

# Docker artifacts (avoids recursion)
Dockerfile*
.dockerignore
docker-compose*.yml
